<h1>プロフィール登録・編集</h1>

<p>ユーザーID：<%= current_user.uid %></p>

<% @profile.errors.full_messages.each do |message| %>
  <p><%= message %></p>
<% end %>

<%= form_with model: @profile,
              url: profile_path,
              method: :patch do |form| %>
  <div>
    <%= form.label :message, "自己紹介" %>
    <br>
    <%= form.text_area :message, rows: 5 %>
  </div>

  <%= form.submit "保存" %>
<% end %>

<% if @profile.persisted? %>
  <%= button_to "プロフィールを削除",
                profile_path,
                method: :delete,
                data: {
                  turbo_confirm: "プロフィールを削除しますか？"
                } %>
<% end %>

<p><%= link_to "トップに戻る", root_path %></p>